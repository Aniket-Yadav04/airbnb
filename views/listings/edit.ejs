<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
  <%- layout('layouts/boilerplate.ejs') %>
</head>
<body>
    <div class="row mt-3">
<div class="col-8 offset-2">
 
    <h2>Edit Your Details</h2>

    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
      
        <div class="mb-3 ">
            <label for="title" class="form-label">Title</label>
            <input required type="text" value="<%=listing.title %>" name="listing[title]" class="form-control"/>
        <div class="invalid-feedback">
        Must Enter Valid Tittle
        </div>
          </div>
       
        <br>
         <div class="mb-3">
             <label for="description" class="form-label" >Description</label>
           <textarea required cols="10" name="listing[description]" rows="3" class="form-control"><%=listing.description %></textarea>
                <div class="invalid-feedback">
         Please Enter Short Description
        </div>
          </div>
       
        <br>
        <div class="mb-3">
             <label for="image" class="form-label" >URL</label>
          <input required class="form-control" name="listing[image][url]"value="<%=listing.image.url %>" type="text" />
             <div class="invalid-feedback">
         Please enter valid Image Address
        </div>
        </div>
       
        <br>
        
        <div class="row">
         <div class="mb-3 col-md-4">
            <label for="price" class="form-label" >Price</label>
            <input required class="form-control" name="listing[price]" value="<%=listing.price %>" type="number" />
                 <div class="invalid-feedback">
         Please Enter valid Price
        </div>
          </div>

          <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input required class="form-control" name="listing[country]" value="<%=listing.country %>" type="text" />
               <div class="invalid-feedback">
         Please Enter Valid Country Name
        </div>
        </div>
        </div>

       
        
        <br>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
         <input  required class="form-control" name="listing[location]" value="<%=listing.location %>" type="text" />
            <div class="invalid-feedback">
         Please Enter Valid Location
        </div>
        </div>
         <br>
         <br>
         <button class=" btn btn-dark edit-btn">ADD</button>
    </form>


</div>
    </div>

<script src="/js/script.js"></script>

    
</body>
</html>