<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
  <%- layout('layouts/boilerplate.ejs') %>
</head>
<body>
    <div class="row mt-3">
<div class="col-8 offset-2">
 
    <h2>Edit Your Details</h2>
    
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" >
      
        <div class="mb-3 ">
            <label for="title" class="form-label">Title</label>
         <input type="text" value="<%=listing.title %>" name="listing[title]" class="form-control"/>
        </div>
       
        <br>
         <div class="mb-3">
             <label for="description" class="form-label" >Description</label>
           <textarea cols="10" name="listing[description]" rows="5" class="form-control"><%=listing.description %></textarea>
         </div>
       
        <br>
        <div class="mb-3">
             <label for="image" class="form-label" >URL</label>
          <input class="form-control" name="listing[image][url]"value="<%=listing.image.url %>" type="text" />
        </div>
       
        <br>
        
        <div class="row">
         <div class="mb-3 col-md-4">
            <label for="price" class="form-label" >Price</label>
         <input class="form-control" name="listing[price]" value="<%=listing.price %>" type="number" />
        </div>

          <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
           <input class="form-control" name="listing[country]" value="<%=listing.country %>" type="text" />
        </div>
        </div>

       
        
        <br>
        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
         <input class="form-control" name="listing[location]" value="<%=listing.location %>" type="text" />
        </div>

      
         <br>
          <br>
         <button class=" btn btn-dark edit-btn">ADD</button>
    </form>


</div>
    </div>



    
</body>
</html>