<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
    <%- layout('/layouts/boilerplate') %>
</head>
<body>
    <h2>Edit Your Details</h2>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" >
        <input type="text" value="<%=listing.title %>" name="listing[title]"/>
        <br>
        <br>
        <textarea cols="20" name="listing[description]" rows="10"><%=listing.description %></textarea>
        <br>
        <br>
        <input  name="listing[image][url]"value="<%=listing.image.url %>" type="text" />
        <br>
        <br>
        <input name="listing[price]" value="<%=listing.price %>" type="number" />
        <br>
        <br>
         <input name="listing[location]" value="<%=listing.location %>" type="text" />
         <br>
         <br>
          <input name="listing[country]" value="<%=listing.country %>" type="text" />
          <br>
          <br>
         <button>ADD</button>
    </form>

    
</body>
</html>