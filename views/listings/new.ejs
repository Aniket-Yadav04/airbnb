<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listings</title>
    <%- layout('/layouts/boilerplate') %>
</head>
<body>

   <div class="row">
    <div class="col-8 offset-2">
    <h1>Add new Listings</h1>
    <form method="post" action="/listings" novalidate class="needs-validation">
    
        <br><br>
        <div class="mb-3">
         <label for="title" class="form-label">Title</label>
         <input type="text" class="form-control" 
         placeholder="Add a Catchy Title"
          name="listing[title]" required/>

         <div class="valid-feedback">
        Title looks good!
        </div>

        </div>
        
         
        <div class="mb-3">
            <label for="description" >Description</label>
             <textarea cols="5" class="form-control" required name="listing[description]" rows="3" placeholder="Enter description here!"></textarea>
              <div class="invalid-feedback">
         Please Enter Short Description
        </div>
        </div>

        <div class="mb-3">
            <label for="image" >URL</label>
             <input class="form-control"  name="listing[image]" required type="text" placeholder="Enter URL_OF_IMG">

        </div>
        
       

        <div>
        <div class="mb-3 col-md-4">
            <label for="price" >Price</label>
            <input name="listing[price]" class="form-control"   type="text" placeholder="1200" required>
               <div class="invalid-feedback">
            Please Enter The Valid Price
        </div>
        </div>
             
             <div class="mb-3 col-md-8">
            <label for="country">Country</label>
            <input name="listing[country]" required class="form-control" type="text" placeholder="India">
             <div class="invalid-feedback">
                Please enter valid country name
             </div>
        </div>
         </div>

          
        <div class="mb-3">
            <label for="location"  >Location</label>
            <input name="listing[location]" required class="form-control"   type="text" placeholder="Jaipur,Rajasthan">
        <div class="invalid-feedback">
            Please Enter Valid Location
        </div>
        </div>
        
         <br>
    
         <button class="btn btn-dark add-btn">ADD</button>
    </form>
    </div>
    </div>
</body>
</html>